# Copy OUTSIDE this repository. Restrict permissions to the deployment operator.
# Supply secrets through the host's secret manager or *_FILE paths with explicit mounts.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=https://communication.example.com
NEXTAUTH_URL=https://communication.example.com
PUBLIC_APP_URL=https://communication.example.com
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
MEDIA_PROVIDER=cloudinary
CLOUDINARY_URL=
MONDAY_API_TOKEN=
# Provider configuration can be provisioned independently; every delivery gate stays off.
PRODUCTION_DELIVERY_ENABLED=false
PROVIDER_PILOT_ENABLED=false
QA_EMAIL_ENABLED=false
SEND_MODE=TEST
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
PRODUCTION_EMAIL_PROVIDER=resend
AXIS_DELIVERY_RELEASE_APPROVED=false
PRODUCTION_DOMAIN_REVIEW_CONFIRMED=false
SCHEDULER_ENABLED=false
SCHEDULER_TRIGGER_SECRET=
MONDAY_WEBHOOK_ENABLED=false
MONDAY_SIGNING_SECRET=
MONDAY_ACCOUNT_ID=
NEWSLETTER_REPLY_TO=noreply@axis-gps.com
