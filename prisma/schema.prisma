// AXIS Customer Communication Platform — Prisma schema
// Authoritative data model: docs/decisions/0009-communication-address-and-dedup-ledger.md
// (refines ADR-0006 / ADR-0007). PostgreSQL only. All schema changes via migrations.
//
// Ownership legend used in comments:
//   [M]  = MONDAY_OWNED (mirrored, read-only, overwritten by sync — NEVER hand-edited)
//   [L]  = LOCAL_OWNED  (a Monday sync must NEVER overwrite these)
//   [S]  = SYSTEM_METADATA (identity / provenance / timestamps)
//   [H]  = IMMUTABLE_HISTORY (audit-safe; preserved across CRM churn)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (env DATABASE_URL), not here.
}

// ============================================================================
// Enums
// ============================================================================
enum Role {
  ADMIN
  MANAGER
}

enum CrmSource {
  MONDAY
}

enum CrmBoardKind {
  CUSTOMERS
  CONTACTS
  PRODUCTS
  CUSTOMER_PRODUCTS
}

enum Language {
  HE
  AR
  UNKNOWN
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  DENIED
}

/// Administrative basis recorded alongside a GRANTED consent (ADR-0021).
/// Documentation of what a PERSON asserted — never a legal determination made by
/// this software. Choosing an adequate basis is the operator's responsibility.
enum ConsentSource {
  EXISTING_CUSTOMER_RELATIONSHIP
  EXPLICIT_CUSTOMER_PERMISSION
  IMPORTED_DOCUMENTED_PERMISSION
  OTHER_DOCUMENTED_BASIS
}

enum EmailStatus {
  UNKNOWN
  VALID
  INVALID
}

enum CompanyCrmStatus {
  POTENTIAL
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SCHEDULED
  SENDING
  SENT
  CANCELED
  FAILED
}

enum SendMode {
  TEST
  PRODUCTION
}

/// Lifecycle of ONE production delivery destination (ADR-0024).
///
/// The pre-existing names are kept exactly as they were — renaming an established
/// state would rewrite the meaning of historical rows. The new members add the
/// distinctions the delivery pipeline actually needs.
enum CampaignRecipientState {
  /// Ledger row prepared from an approved final audience. Nothing has been attempted.
  PENDING
  /// Passed the dispatch-time veto re-check and is claimed for submission.
  READY
  /// Being submitted to the provider (the "SUBMITTING" phase).
  SENDING
  /// Provider took responsibility for delivery. NOT proof the recipient received it.
  ACCEPTED
  /// Provider event confirmed delivery to the recipient's mail server.
  DELIVERED
  /// Provider event reported a hard bounce. Feeds Suppression.
  BOUNCED
  /// Provider event reported a spam complaint. Feeds Suppression.
  COMPLAINED
  /// Provider definitively refused. Safe to retry once the cause is fixed.
  FAILED
  /// We do not know whether the provider accepted it (timeout / unreadable response).
  /// NEVER auto-retried — that could duplicate a real customer email.
  UNCERTAIN
  /// Vetoed at dispatch time by a high-authority fact (unsubscribe, suppression,
  /// invalid address) that arrived after the audience was approved. Never submitted.
  SUPPRESSED
  /// Legacy aggregate from before ACCEPTED/DELIVERED existed. Not produced by new code.
  SENT
}

enum TestSendState {
  QUEUED
  // Ledger row written BEFORE the provider is called (durable attempt record).
  SENDING
  // Provider returned 202: it accepted the message for delivery. NOT proof of delivery.
  ACCEPTED
  // Provider may or may not have accepted (timeout / crash / unreadable response).
  // Requires manual reconciliation — never auto-retried, as that could duplicate mail.
  UNCERTAIN
  // Reserved for a future real delivery confirmation (webhook), distinct from ACCEPTED.
  SENT
  FAILED
}

enum EmailProviderKind {
  GMAIL_SMTP
  // Retained only so historical rows stay readable; no longer selectable (ADR-0014).
  MICROSOFT_GRAPH
  FAKE
  /// The deliberately inert production adapter (ADR-0024). It refuses to send, so a
  /// row carrying this value proves a dry run, never a delivery.
  PRODUCTION_DISABLED
  /// The production provider (ADR-0025). Used by the internal PROVIDER PILOT and,
  /// later, by customer delivery. NEVER used by the Gmail SAFE TEST path.
  RESEND
}

/// Which independent sending channel a row belongs to (ADR-0025).
///
/// The two are deliberately not interchangeable: SAFE TEST goes through Gmail SMTP to
/// one hard-coded address, and PROVIDER PILOT goes through Resend to one hard-coded
/// address. An approval minted for one can never authorise a submission on the other,
/// because the channel is part of what is checked.
enum SendChannel {
  SAFE_TEST_GMAIL
  PROVIDER_PILOT
}

enum EmailSourceType {
  COMPANY_EMAIL
  CONTACT_EMAIL
}

enum ExclusionReason {
  NO_EMAIL
  INVALID_EMAIL
  UNSUBSCRIBED
  SUPPRESSED
  CONSENT_DENIED
  // Nobody refused, and nobody confirmed. Produced only when a caller asks for an
  // explicit GRANTED consent (ADR-0021); the v1 default treats UNKNOWN as passable
  // and reports the count instead of hiding it.
  CONSENT_NOT_CONFIRMED
  COMPANY_INACTIVE
  ARCHIVED
  LANGUAGE_UNKNOWN
}

enum CampaignEventType {
  DELIVERED
  OPENED
  CLICKED
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
  DEFERRED
  DROPPED
  FAILED
}

enum SuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  PROVIDER_PERMANENT
}

enum UnsubscribeScope {
  GLOBAL
}

/// Why an unsubscribe token exists (ADR-0024). A FIXTURE token can only ever act on a
/// synthetic test address; it is how the flow is exercised without touching a customer.
enum UnsubscribeTokenPurpose {
  PRODUCTION
  FIXTURE
}

enum UnsubscribeSource {
  RECIPIENT_LINK
  MANUAL
  PROVIDER_WEBHOOK
  IMPORT
}

enum ContentOrigin {
  INTERNAL
  INGESTED
}

enum ContentSourceKind {
  INTERNAL
  RSS
  /// Atom 1.0 feed. Parsed by the same reader as RSS (ADR-0026).
  ATOM
  WEBSITE
  API
  MANUAL_EXTERNAL
}

enum ContentReviewState {
  NEW
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum Cadence {
  WEEKLY
  MONTHLY
}

enum AutomationMode {
  ASSISTED
}

enum AutomationRunStatus {
  PENDING
  PREPARING
  PREPARED
  /// Some sources failed but the run still completed usefully (ADR-0026).
  PARTIAL
  FAILED
  /// Nothing new to put in a newsletter. NOT an error, and never shown as one.
  NO_CONTENT
  SKIPPED
}

enum IngestionRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
  BOOTSTRAP
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncItemAction {
  UPSERT
  ARCHIVE
  SKIP
  ERROR
}

enum SyncItemClass {
  SENDABLE
  INCOMPLETE
  NO_EMAIL
  INVALID_EMAIL
  CONFLICT
  ERROR
}

enum AuditAction {
  CAMPAIGN_CREATED
  CAMPAIGN_SUBMITTED
  CAMPAIGN_APPROVED
  CAMPAIGN_REJECTED
  CAMPAIGN_SCHEDULED
  CAMPAIGN_SENT
  CAMPAIGN_CANCELED
  TEST_SEND_APPROVED
  TEST_SEND_ATTEMPTED
  SEND_MODE_CHANGED
  PRODUCTION_ENABLED
  UNSUBSCRIBE
  SUPPRESSION
  // Local communication state changed by staff (ADR-0020). Language only in v1 —
  // consent and suppression are deliberately NOT bulk-editable.
  COMMUNICATION_LANGUAGE_CHANGED
  // Local consent changed by staff (ADR-0021). Carries the recorded basis, the
  // effective date, and the bulk batch id when part of one.
  COMMUNICATION_CONSENT_CHANGED
  // Send readiness (ADR-0022). None of these send anything.
  FINAL_AUDIENCE_PREPARED
  PRODUCTION_APPROVAL_RECORDED
  PRODUCTION_APPROVAL_REVOKED
  CRM_SYNC
  // Authentication & user administration (ADR-0023). Never carries a password,
  // a password hash, or a session token.
  ADMIN_BOOTSTRAPPED
  USER_CREATED
  USER_ROLE_CHANGED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_PASSWORD_CHANGED
  USER_SIGNED_IN
  USER_SIGN_IN_FAILED
  // Production delivery preparation (ADR-0024). None of these sends anything.
  DELIVERY_LEDGER_PREPARED
  PROVIDER_EVENT_INGESTED
  // Production provider onboarding (ADR-0025). None of these sends a customer email.
  PROVIDER_DOMAIN_CHECKED
  PROVIDER_PILOT_APPROVED
  PROVIDER_PILOT_ATTEMPTED
  WEBHOOK_REJECTED
  // Content sourcing, review and assisted automation (ADR-0026). None of these
  // sends anything, and none creates a CampaignRecipient.
  CONTENT_SOURCE_CREATED
  CONTENT_SOURCE_UPDATED
  CONTENT_SOURCE_ENABLED
  CONTENT_SOURCE_DISABLED
  CONTENT_INGESTION_RUN
  CONTENT_APPROVED
  CONTENT_REJECTED
  NEWSLETTER_DRAFT_CREATED_FROM_CONTENT
  AUTOMATION_CREATED
  AUTOMATION_UPDATED
  AUTOMATION_PAUSED
  AUTOMATION_ENABLED
  AUTOMATION_RUN
  ADMIN_CHANGE
}

// ============================================================================
// Email-centric communication profile (LOCAL, sync-immune)
// ============================================================================
model CommunicationAddress {
  id                  String         @id @default(cuid())
  normalizedEmail     String         @unique // [S] globally-unique communication identity
  emailStatus         EmailStatus    @default(UNKNOWN) // [L]
  language            Language       @default(UNKNOWN) // [L] never inferred
  consentStatus       ConsentStatus  @default(UNKNOWN) // [L] never inferred
  // --- consent evidence (ADR-0021), all [L] and all sync-immune ---
  // Nullable because UNKNOWN and DENIED record no basis: refusing to send never
  // needs paperwork. A GRANTED row always carries source + effectiveAt.
  consentSource       ConsentSource? // [L] documented basis a person selected
  consentNote         String? // [L] free-text description of that basis
  consentEffectiveAt  DateTime? // [L] the date the permission applies from
  consentRecordedAt   DateTime? // [L] when a person made the change here
  consentRecordedById String? // [L] actor; nav only (no FK — actors outlive users)
  consentBatchId      String? // [L] groups one bulk operation
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  recipients   CampaignRecipient[]
  unsubscribes Unsubscribe[]
  suppressions Suppression[]

  @@index([emailStatus])
  @@index([language])
  @@index([consentStatus])
  @@index([consentBatchId])
}

// ============================================================================
// CRM projections (Monday-owned)
// ============================================================================
model Company {
  id                String           @id @default(cuid())
  mondayBoardId     String // [S]
  mondayItemId      String // [S]
  source            CrmSource        @default(MONDAY) // [S]
  mondayUpdatedAt   DateTime? // [S]
  syncedAt          DateTime? // [S]
  archivedAt        DateTime? // [S] local archive marker
  mondayDeletedAt   DateTime? // [S]
  rawItem           Json? // [S] raw Monday snapshot
  name              String? // [M]
  companyNumber     String? // [M] ח.פ
  hashavshevetId    String? // [M]
  accountKey        String? // [M]
  companyEmail      String? // [M] מייל חברה — campaign candidate
  companyEmailNorm  String? // [S] derived lookup
  accountingEmail   String? // [M] מייל להנה"ח — NEVER a campaign candidate
  companyPhone      String? // [M]
  category          String? // [M] free-text Monday value
  customerStatus    CompanyCrmStatus @default(UNKNOWN) // [M] normalized
  customerStatusRaw String? // [M] raw label
  city              String? // [M]
  address           String? // [M]
  industryId        String? // [M]-derived ref
  classificationId  String? // [M]-derived ref
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  industry        Industry?                 @relation(fields: [industryId], references: [id], onDelete: SetNull)
  classification  CustomerClassification?   @relation(fields: [classificationId], references: [id], onDelete: SetNull)
  contactLinks    CompanyContact[]
  ownedProducts   CustomerProduct[]
  catalogueLinks  CompanyProduct[]
  recipientSource CampaignRecipientSource[]

  @@unique([mondayBoardId, mondayItemId])
  @@index([companyEmailNorm])
  @@index([customerStatus])
  @@index([industryId])
  @@index([classificationId])
  @@index([archivedAt])
  @@index([syncedAt])
}

model Contact {
  id              String    @id @default(cuid())
  mondayBoardId   String // [S]
  mondayItemId    String // [S]
  source          CrmSource @default(MONDAY) // [S]
  mondayUpdatedAt DateTime? // [S]
  syncedAt        DateTime? // [S]
  archivedAt      DateTime? // [S]
  mondayDeletedAt DateTime? // [S]
  rawItem         Json? // [S]
  fullName        String? // [M] no first/last split in v1
  email           String? // [M] raw
  emailNorm       String? // [S] derived lookup
  phone           String? // [M]
  jobTitle        String? // [M]
  address         String? // [M]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // NOTE: emailStatus / language / consentStatus intentionally NOT here — see CommunicationAddress.
  // NOTE: no CRM status column exists in Monday for contacts (do not invent ACTIVE/INACTIVE).

  companyLinks    CompanyContact[]
  ownedProducts   CustomerProduct[]
  recipientSource CampaignRecipientSource[]

  @@unique([mondayBoardId, mondayItemId])
  @@index([emailNorm])
  @@index([archivedAt])
}

// Many-to-many Company <-> Contact (mirrors Monday Connect Boards)
model CompanyContact {
  id         String       @id @default(cuid())
  companyId  String
  contactId  String
  assertedBy CrmBoardKind // which board's relation column asserted the link
  syncedAt   DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([companyId, contactId])
  @@index([contactId])
}

// Reference tables (Company-level taxonomy from Monday status labels)
model Industry {
  id               String    @id @default(cuid())
  mondayColumnId   String // color_mkprbck1
  mondayLabelIndex Int
  label            String // current display (may be renamed without corrupting history)
  colorVarName     String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  companies        Company[]

  @@unique([mondayColumnId, mondayLabelIndex])
}

model CustomerClassification {
  id               String    @id @default(cuid())
  mondayColumnId   String // color_mm1gzaje
  mondayLabelIndex Int
  label            String
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  companies        Company[]

  @@unique([mondayColumnId, mondayLabelIndex])
}

// Product catalogue projection (board 1903021552)
model Product {
  id            String            @id @default(cuid())
  mondayBoardId String
  mondayItemId  String
  name          String? // [M]
  itemKey       String? // [M] מפתח פריט
  sku           String? // [M] מק"ט
  catalogLink   String? // [M] קטלוג מוצרים
  itemType      String? // [M] סוג פריט (mirrored label string)
  rawItem       Json?
  syncedAt      DateTime?
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  instances     CustomerProduct[]
  companyLinks  CompanyProduct[]

  @@unique([mondayBoardId, mondayItemId])
  @@index([itemType])
}

// Owned product instance / subscription (board 1903021951)
model CustomerProduct {
  id                    String    @id @default(cuid())
  mondayBoardId         String
  mondayItemId          String
  companyId             String? // ← לקוח (nav only)
  contactId             String? // ← איש קשר (nav only)
  productId             String? // ← מוצר (catalogue)
  status                String? // סטטוס
  purchaseDate          DateTime?
  hardwareWarrantyUntil DateTime?
  softwareWarrantyUntil DateTime?
  subscriptionUntil     DateTime?
  subscriptionLoginId   String?
  billingType           String?
  includesCommsPackage  Boolean?
  simCount              Int?
  rawItem               Json?
  syncedAt              DateTime?
  archivedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([mondayBoardId, mondayItemId])
  @@index([companyId])
  @@index([contactId])
  @@index([productId])
  @@index([subscriptionUntil])
  @@index([status])
}

// Optional/secondary: direct Company -> catalogue association (board_relation_mkrydxdp)
model CompanyProduct {
  id        String    @id @default(cuid())
  companyId String
  productId String
  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([companyId, productId])
  @@index([productId])
}

// ============================================================================
// Users / content / segments / campaigns (local)
// ============================================================================
/// AXIS staff account (ADR-0003, implemented by ADR-0023).
///
/// `passwordHash` holds an Argon2id PHC string and NOTHING else — never a plaintext
/// password, never a reversibly-encrypted one. It is never selected into any type
/// that reaches a client component.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  role               Role      @default(MANAGER)
  passwordHash       String
  isActive           Boolean   @default(true)
  /// Marks a non-human historical actor (the pre-authentication development
  /// stand-in). A system account can NEVER sign in and can never satisfy a
  /// production approval, but its id stays referenced by historical audit rows.
  isSystemAccount    Boolean   @default(false)
  /// Set when an administrator issues an initial or reset password, so the user is
  /// asked to choose their own. See ADR-0023 for the v1 limitation.
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  deactivatedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdCampaigns    Campaign[]                   @relation("CampaignCreator")
  approvedCampaigns   Campaign[]                   @relation("CampaignApprover")
  testSendApprovals   CampaignTestApproval[]       @relation("TestSendApprover")
  productionApprovals CampaignProductionApproval[] @relation("ProductionApprover")
  preparedAudiences   CampaignFinalAudience[]      @relation("FinalAudiencePreparer")
  createdSources      ContentSource[]              @relation("ContentSourceCreator")
  reviewedContent     ContentItem[]                @relation("ContentReviewer")

  @@index([isActive])
  @@index([role])
}

model ContentItem {
  id            String             @id @default(cuid())
  title         String
  summary       String? // excerpt/summary — external items may be link+title+summary only
  language      Language           @default(UNKNOWN) // UNKNOWN valid during ingestion; human review can correct
  origin        ContentOrigin      @default(INTERNAL)
  reviewState   ContentReviewState @default(APPROVED) // ingestion service creates INGESTED items as PENDING_REVIEW
  subject       String?
  preheader     String?
  bodyHtml      String? // optional — external content may not carry full HTML
  bodyText      String?
  // Lead image shown at the top of this item in the rendered newsletter.
  // `imageUrl` is an application-owned reference (media route or absolute URL) —
  // binary data is NEVER stored in PostgreSQL (see MediaStore port).
  imageUrl      String?
  imageAlt      String? // accessibility + shown when an email client blocks images
  // external / ingested provenance
  sourceId      String?
  sourceName    String? // display origin name (e.g. "Trimble")
  author        String?
  externalId    String? // stable id from the source (dedup)
  externalUrl   String?
  /// The publisher's own canonical URL when the feed declares one.
  canonicalUrl  String?
  /// Lower-cased, tracking-parameter-stripped form of the canonical/external URL.
  /// The dedup key: the same article re-polled, or syndicated on two feed paths,
  /// collapses here. Deliberately scoped PER SOURCE — two publishers covering the
  /// same story are two articles, not one (ADR-0026).
  normalizedUrl String?
  publishedAt   DateTime?
  ingestedAt    DateTime?
  // --- AXIS EDITORIAL COPY (ADR-0026) ---
  // Kept strictly apart from the mirrored source metadata above. Staff write these;
  // a re-ingestion refreshes the source fields and must NEVER touch these.
  axisHeadline  String?
  axisSummary   String?
  ctaLabel      String?
  ctaUrl        String?
  /// Internal note for colleagues. Never rendered into an email.
  internalNote  String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdById   String? // internal content author
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  source        ContentSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  reviewedBy    User?                 @relation("ContentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  campaignLinks CampaignContentItem[]

  @@unique([sourceId, externalId]) // idempotent external ingestion where both present
  @@unique([sourceId, normalizedUrl]) // same article, same source, one row
  @@index([reviewState])
  @@index([origin])
  @@index([language])
  @@index([sourceId])
}

model Segment {
  id          String                 @id @default(cuid())
  name        String
  description String?
  criteria    Json // validated structured filter tree (AND/OR)
  isActive    Boolean                @default(true)
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  campaigns   Campaign[]
  automations NewsletterAutomation[]
}

model Campaign {
  id                String         @id @default(cuid())
  name              String
  language          Language
  status            CampaignStatus @default(DRAFT)
  sendMode          SendMode       @default(TEST) // TEST is the default
  segmentId         String?
  // Editable working copy (DRAFT only). Frozen into snapshotSubject/snapshotPreheader
  // at approval/send — the snapshot, not these, is the authoritative sent record.
  subject           String?
  preheader         String?
  // content snapshot frozen at submit/approve → history reproducible (authoritative record of what was sent)
  snapshotSubject   String?
  snapshotPreheader String?
  snapshotBodyHtml  String?
  snapshotBodyText  String?
  snapshotAt        DateTime?
  createdById       String
  approvedById      String? // four-eyes: must differ from creator (enforced server-side)
  approvedAt        DateTime?
  rejectionReason   String?
  scheduledAt       DateTime?
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  creator             User                         @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approver            User?                        @relation("CampaignApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  segment             Segment?                     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  contentLinks        CampaignContentItem[] // ordered multi-content composition
  recipients          CampaignRecipient[] // Restrict — history protected
  events              CampaignEvent[] // Restrict — history protected
  testSends           CampaignTestSend[] // Restrict — history protected
  testApprovals       CampaignTestApproval[] // Cascade — approvals are re-creatable, not history
  snapshots           CampaignAudienceSnapshot[] // Cascade — re-derivable preview
  exclusions          CampaignAudienceExclusion[] // Cascade — re-derivable preview
  finalAudiences      CampaignFinalAudience[] // Cascade — frozen, append-only
  productionApprovals CampaignProductionApproval[] // Cascade — re-approvable, not history
  automationRun       NewsletterAutomationRun? // set when generated by a recurring automation

  @@index([status])
  @@index([scheduledAt])
}

// ============================================================================
// Content composition, sources, external ingestion & recurring automation
// ============================================================================

// Ordered multi-content composition (Campaign <-> ContentItem)
model CampaignContentItem {
  id                  String    @id @default(cuid())
  campaignId          String
  contentItemId       String
  position            Int
  isIncluded          Boolean   @default(true)
  customHeading       String?
  customIntro         String?
  // immutable snapshot frozen at approval/send (history reproducible)
  snapshotTitle       String?
  snapshotBodyHtml    String?
  snapshotBodyText    String?
  snapshotExternalUrl String?
  snapshotAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  campaign    Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)

  @@unique([campaignId, contentItemId]) // no accidental duplicate inclusion of the same item
  @@index([campaignId, position])
  @@index([contentItemId])
}

// Approved content sources (internal + external)
model ContentSource {
  id               String            @id @default(cuid())
  name             String
  kind             ContentSourceKind
  /// Human-facing website for this source (display only — never fetched).
  baseUrl          String?
  /// The feed actually fetched. Validated as a PUBLIC http(s) URL before it is
  /// stored and again immediately before every request (ADR-0026) — a stored row
  /// is untrusted input, and DNS can change under a name that once looked safe.
  feedUrl          String?
  isEnabled        Boolean           @default(true)
  /// Declared language of this source's articles. `UNKNOWN` unless a person set it;
  /// never inferred from a domain, exactly as with communication language.
  language         Language          @default(UNKNOWN)
  /// Free-form staff labels for filtering the review inbox. Not a taxonomy.
  categories       String[]          @default([])
  config           Json? // review/trust configuration (no secrets)
  /// When ingestion last ATTEMPTED this source, successful or not.
  lastCheckedAt    DateTime?
  /// When ingestion last SUCCEEDED. Kept apart from the above so a source that is
  /// being polled but has been failing for a week is visible as exactly that.
  lastSucceededAt  DateTime?
  lastErrorMessage String? // friendly text; never a stack trace, never a URL secret
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  createdBy     User?                        @relation("ContentSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items         ContentItem[]
  ingestionRuns ContentIngestionRun[]
  automations   NewsletterAutomationSource[]

  @@index([kind])
  @@index([isEnabled])
}

// Lightweight external ingestion history (NO network fetching implemented yet)
model ContentIngestionRun {
  id              String             @id @default(cuid())
  sourceId        String
  status          IngestionRunStatus @default(RUNNING)
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  discoveredCount Int                @default(0)
  createdCount    Int                @default(0)
  duplicateCount  Int                @default(0)
  errorCount      Int                @default(0)
  errorMessage    String?
  /// Groups the per-source runs of ONE "check sources now" into a single batch, so
  /// one failing source can be reported without failing the others (ADR-0026).
  batchId         String?
  triggeredById   String?
  createdAt       DateTime           @default(now())

  source ContentSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
}

// Recurring newsletter automation — ASSISTED by default (prepares drafts; never auto-sends)
model NewsletterAutomation {
  id              String         @id @default(cuid())
  name            String
  isEnabled       Boolean        @default(true) // paused when false
  mode            AutomationMode @default(ASSISTED)
  cadence         Cadence
  interval        Int            @default(1) // every N weeks/months
  dayOfWeek       Int? // 0-6 (WEEKLY)
  dayOfMonth      Int? // 1-31 (MONTHLY)
  weekOfMonth     Int? // optional nth week (MONTHLY)
  timezone        String         @default("Asia/Jerusalem")
  recurrence      Json? // optional structured recurrence (internal; never RRULE exposed to users)
  language        Language
  segmentId       String?
  /// Upper bound on candidate articles considered for one draft. A newsletter that
  /// silently grew to forty items would be nobody's intent.
  maxItems        Int            @default(5)
  /// Optional source category filter. Null means "any category".
  category        String?
  nextScheduledAt DateTime?
  lastRunAt       DateTime?
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  segment Segment?                     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  sources NewsletterAutomationSource[]
  runs    NewsletterAutomationRun[]

  @@index([isEnabled])
  @@index([nextScheduledAt])
  @@index([segmentId])
}

// One run per (automation, scheduled occurrence) — idempotent campaign generation
/// Which approved sources an automation draws candidates from (ADR-0026).
///
/// An automation with no sources draws from every enabled source; naming sources
/// narrows it. This is a selection of ALREADY-APPROVED sources — it can never
/// introduce a URL of its own.
model NewsletterAutomationSource {
  automationId String
  sourceId     String
  createdAt    DateTime @default(now())

  automation NewsletterAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  source     ContentSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([automationId, sourceId])
  @@index([sourceId])
}

model NewsletterAutomationRun {
  id                  String              @id @default(cuid())
  automationId        String
  scheduledFor        DateTime
  status              AutomationRunStatus @default(PENDING)
  startedAt           DateTime?
  completedAt         DateTime?
  generatedCampaignId String?             @unique
  errorMessage        String?
  // --- what the run actually saw, so "nothing happened" is explainable ---
  /// Candidate articles the run considered.
  itemsFound          Int                 @default(0)
  /// Articles newly ingested during this run.
  itemsNew            Int                 @default(0)
  /// APPROVED articles actually attached to the draft. Unreviewed content is never
  /// counted here, because it is never used (ADR-0026).
  itemsUsed           Int                 @default(0)
  /// Sources that failed during this run. A non-zero value with a created draft is
  /// PARTIAL, not FAILED.
  sourcesFailed       Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  automation        NewsletterAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  generatedCampaign Campaign?            @relation(fields: [generatedCampaignId], references: [id], onDelete: SetNull)

  @@unique([automationId, scheduledFor]) // at most one run per occurrence → idempotent
  @@index([automationId])
  @@index([status])
}

// ============================================================================
// Deduplicated production delivery ledger (one per campaign + normalized email)
// ============================================================================
/// ONE production delivery destination per (campaign, normalized email).
///
/// Rows are created ONLY from an approved, current `CampaignFinalAudience` — never
/// from user input, a preview, or an arbitrary address (ADR-0024). `finalAudienceId`
/// is required precisely so "where did this recipient come from?" always has an answer.
model CampaignRecipient {
  id                     String                 @id @default(cuid())
  campaignId             String
  /// The frozen audience this destination came from. Required: a recipient with no
  /// provenance is a recipient nobody approved.
  finalAudienceId        String
  normalizedEmail        String // [H] dedup key + immutable snapshot
  communicationAddressId String? // nav only
  intendedEmail          String // real chosen destination (audit)
  state                  CampaignRecipientState @default(PENDING)
  /// Communication state captured when the ledger was prepared, so a later change is
  /// visible as a change rather than silently rewriting what was approved.
  languageAtPreparation  Language               @default(UNKNOWN)
  consentAtPreparation   ConsentStatus          @default(UNKNOWN)
  preparedById           String?
  preparedAt             DateTime?
  /// Set when a dispatch-time veto stopped this destination. Uses the same reason
  /// vocabulary as audience exclusions — there is one eligibility vocabulary.
  vetoReason             ExclusionReason?
  // claim / recovery
  attemptCount           Int                    @default(0)
  firstAttemptAt         DateTime?
  lastAttemptAt          DateTime?
  claimedAt              DateTime?
  providerMessageId      String?
  failureReason          String?
  // engagement convenience (derived from events)
  sentAt                 DateTime?
  deliveredAt            DateTime?
  firstOpenedAt          DateTime?
  firstClickedAt         DateTime?
  bouncedAt              DateTime?
  complainedAt           DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  campaign      Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  finalAudience CampaignFinalAudience     @relation(fields: [finalAudienceId], references: [id], onDelete: Restrict)
  address       CommunicationAddress?     @relation(fields: [communicationAddressId], references: [id], onDelete: SetNull)
  sources       CampaignRecipientSource[]
  events        CampaignEvent[]

  @@unique([campaignId, normalizedEmail]) // <-- prevents double delivery
  @@index([campaignId])
  @@index([finalAudienceId])
  @@index([normalizedEmail])
  @@index([state])
}

// Every contributing CRM record — non-null immutable identity
model CampaignRecipientSource {
  id               String          @id @default(cuid())
  recipientId      String
  sourceBoardId    String // [H] immutable Monday identity
  sourceItemId     String // [H] immutable Monday identity
  sourceEntityType CrmBoardKind // [H]
  emailSourceType  EmailSourceType // [H]
  sourceEmailRaw   String // [H] exact pre-normalization email
  companyId        String? // nav only
  contactId        String? // nav only
  createdAt        DateTime        @default(now())

  recipient CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  company   Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([recipientId, sourceBoardId, sourceItemId, emailSourceType])
  @@index([companyId])
  @@index([contactId])
  @@index([sourceBoardId, sourceItemId])
}

// ============================================================================
// Audience preview / exclusions (NOT delivery — no fake recipient rows)
// ============================================================================
model CampaignAudienceSnapshot {
  id                        String   @id @default(cuid())
  campaignId                String
  resolvedAt                DateTime @default(now())
  matchedRecords            Int
  withCandidateEmail        Int
  eligible                  Int
  uniqueDestinations        Int
  excluded                  Int
  duplicateSourcesCollapsed Int // duplicates retained as sources, NOT exclusions
  breakdown                 Json // counts per ExclusionReason
  campaign                  Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model CampaignAudienceExclusion {
  id               String           @id @default(cuid())
  campaignId       String
  sourceBoardId    String
  sourceItemId     String
  sourceEntityType CrmBoardKind
  emailSourceType  EmailSourceType?
  sourceEmailRaw   String?
  normalizedEmail  String?
  reason           ExclusionReason
  createdAt        DateTime         @default(now())
  campaign         Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([reason])
}

// ============================================================================
// Test send — isolated from the production ledger (does NOT fan out)
// ============================================================================
model CampaignTestSend {
  id                       String             @id @default(cuid())
  campaignId               String
  requestedById            String
  fromEmail                String // axisgpscana@gmail.com (ADR-0014)
  replyToEmail             String? // noreply@axis-gps.com (ADR-0019)
  senderName               String? // "AXIS Advanced Mapping Solutions"
  toEmail                  String // khaled-s@axis-gps.com
  simulatedNormalizedEmail String?
  simulatedSourceBoardId   String?
  simulatedSourceItemId    String?
  subjectSnapshot          String?
  /// Which channel actually carried this attempt (ADR-0025).
  channel                  SendChannel        @default(SAFE_TEST_GMAIL)
  state                    TestSendState      @default(QUEUED)
  providerMessageId        String?
  failureReason            String?
  createdAt                DateTime           @default(now())
  sentAt                   DateTime?
  // --- SAFE TEST send via an email provider (ADR-0013) ---
  // One approval authorizes at most ONE provider submission. This UNIQUE FK is the
  // database-level idempotency guard: a concurrent/duplicate submit collides here and
  // never reaches the provider. Never store OAuth tokens on this row.
  approvalId               String?            @unique
  idempotencyKey           String?            @unique
  provider                 EmailProviderKind?
  contentHash              String? // canonical hash actually submitted
  providerStatusCode       Int? // e.g. 202
  failureCode              String? // sanitized classification, never a token
  attemptedAt              DateTime?
  acceptedAt               DateTime? // provider ACCEPTED (202) — not delivery

  campaign Campaign              @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  approval CampaignTestApproval? @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([state])
}

/// Explicit human approval of ONE exact test email (ADR-0013).
///
/// `contentHash` freezes the fully-rendered message (subject, preheader, HTML, text,
/// ordered content, sender, recipient, send mode). At send time the newsletter is
/// re-rendered and re-hashed; any difference invalidates the approval. A client-side
/// "approved=true" is never trusted.
model CampaignTestApproval {
  id                String      @id @default(cuid())
  campaignId        String
  contentHash       String // SHA-256 over the deterministic canonical payload
  subjectSnapshot   String
  preheaderSnapshot String?
  fromEmail         String
  // Where replies were directed when this was approved (ADR-0019). Nullable only for
  // approvals created before the column existed; those can never be valid again.
  replyToEmail      String?
  senderName        String?
  toEmail           String
  sendMode          SendMode    @default(TEST)
  /// Which channel this approval authorises (ADR-0025). An approval for the Gmail
  /// SAFE TEST can never authorise a Resend PROVIDER PILOT submission, or vice versa.
  channel           SendChannel @default(SAFE_TEST_GMAIL)
  approvedById      String
  approvedAt        DateTime    @default(now())
  // Single-use: set when an attempt is created. A consumed approval can never authorize
  // a second submission.
  consumedAt        DateTime?
  // Superseded by a newer approval, or invalidated because the content changed.
  revokedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approvedBy User              @relation("TestSendApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  testSend   CampaignTestSend?

  @@index([campaignId])
  @@index([contentHash])
  @@index([consumedAt])
}

// ============================================================================
// FINAL send-time audience (ADR-0022) — append-only, immutable, still not delivery
// ============================================================================
//
// `CampaignAudienceSnapshot` above is PLANNING: re-derivable, replaced whenever it is
// recomputed. The three models below are the opposite — a frozen record of exactly
// who a specific approval was granted against. They are written once and NEVER
// updated: preparing the audience again creates a NEW `CampaignFinalAudience` row,
// and the newest row is the current one. That is what makes "the snapshot used for
// approval cannot change later" a property of the schema rather than a promise.
//
// Still not delivery: no `CampaignRecipient`, no `CampaignEvent`, no provider call.
// A destination here is a frozen answer to "who would receive this", which is why it
// is a separate table from the production ledger rather than an early write into it.

model CampaignFinalAudience {
  id                        String    @id @default(cuid())
  campaignId                String
  // Frozen copy of the audience definition. `segmentId` may later be repointed or the
  // segment deleted; the rules that produced THIS audience stay readable regardless.
  segmentId                 String?
  segmentName               String
  segmentCriteria           Json
  // Campaign language at freeze time, and the language addresses had to match
  // (null for a non-localized campaign).
  campaignLanguage          Language
  requireLanguage           Language?
  // Whether an explicitly GRANTED consent was required (ADR-0021). False in v1.
  requireExplicitConsent    Boolean   @default(false)
  // ---- counts, all reported in the UI; nothing disappears silently ----
  matchedCompanies          Int
  matchedContacts           Int
  matchedRecords            Int
  withCandidateEmail        Int
  eligible                  Int
  uniqueDestinations        Int
  excluded                  Int
  duplicateSourcesCollapsed Int
  consentGranted            Int       @default(0)
  consentNotConfirmed       Int       @default(0)
  breakdown                 Json // counts per ExclusionReason
  // ---- staleness ----
  // SHA-256 over the canonical audience payload (domain/audience/finalAudience.ts).
  // Staleness is a comparison against a fresh resolution, never a stored flag that
  // something has to remember to set.
  audienceHash              String
  crmLastSyncedAt           DateTime? // newest CRM sync considered, when known
  crmSyncRunId              String? // provenance of that sync
  destinationsTruncated     Boolean   @default(false)
  exclusionsTruncated       Boolean   @default(false)
  /// Cheap fingerprint of every table that can move a person in or out of this
  /// audience (ADR-0023 §readiness cost). When it still matches, the frozen snapshot
  /// is provably current and the full re-resolution is skipped. Any mismatch — or an
  /// empty value on a pre-existing row — forces a full re-resolution, so the
  /// optimisation can only ever fail towards doing MORE work, never towards
  /// reporting a stale audience as fresh.
  resolutionWatermark       String    @default("")
  /// One logical preparation per token. A double-clicked or retried request carries
  /// the same token and collides on the UNIQUE index below, so it returns the
  /// snapshot that already exists instead of freezing a second one. A later,
  /// deliberate preparation sends a fresh token and is allowed.
  preparationKey            String?
  createdById               String
  createdAt                 DateTime  @default(now())

  campaign     Campaign                           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  preparedBy   User                               @relation("FinalAudiencePreparer", fields: [createdById], references: [id], onDelete: Restrict)
  destinations CampaignFinalAudienceDestination[]
  exclusions   CampaignFinalAudienceExclusion[]
  approvals    CampaignProductionApproval[]
  recipients   CampaignRecipient[] // Restrict — a prepared ledger protects its source

  @@unique([campaignId, preparationKey]) // <-- idempotency guard (NULLs never collide)
  @@index([campaignId, createdAt])
  @@index([audienceHash])
}

/// One frozen deliverable destination. `sources` holds the contributing CRM records
/// as immutable JSON: it is written once with the row and read back with it, never
/// queried across snapshots, so a child table would add joins without adding safety.
/// The accounting address has no code path anywhere and can never appear here.
model CampaignFinalAudienceDestination {
  id              String        @id @default(cuid())
  finalAudienceId String
  normalizedEmail String // [H] frozen dedup key
  intendedEmail   String // [H] exact address chosen for delivery
  language        Language
  consentStatus   ConsentStatus
  emailStatus     EmailStatus
  sources         Json // [H] frozen provenance: board/item/kind/raw email/label
  sourceCount     Int           @default(1)
  createdAt       DateTime      @default(now())

  finalAudience CampaignFinalAudience @relation(fields: [finalAudienceId], references: [id], onDelete: Cascade)

  @@unique([finalAudienceId, normalizedEmail]) // one destination per email, frozen
  @@index([finalAudienceId])
  @@index([normalizedEmail])
}

/// Frozen exclusions for the same moment. Kept separate from
/// `CampaignAudienceExclusion` (which is planning data and gets replaced) so an
/// approved audience keeps its own explanation of who was left out and why.
model CampaignFinalAudienceExclusion {
  id               String          @id @default(cuid())
  finalAudienceId  String
  sourceBoardId    String
  sourceItemId     String
  sourceEntityType CrmBoardKind
  emailSourceType  EmailSourceType
  sourceEmailRaw   String?
  normalizedEmail  String?
  reason           ExclusionReason
  label            String? // friendly CRM name at freeze time
  createdAt        DateTime        @default(now())

  finalAudience CampaignFinalAudience @relation(fields: [finalAudienceId], references: [id], onDelete: Cascade)

  @@index([finalAudienceId])
  @@index([finalAudienceId, reason])
}

/// Explicit human approval of ONE exact newsletter sent to ONE exact frozen audience
/// (ADR-0022). Same philosophy as `CampaignTestApproval`, extended with the audience.
///
/// `contentHash` freezes subject, preheader, HTML, text, ordered content, image URLs,
/// campaign language, sender identity, reply-to AND the final audience id + hash. At
/// readiness time everything is re-derived and re-hashed; any difference invalidates
/// the approval. A client-side "approved=true" is never trusted.
///
/// This row authorizes nothing on its own — production delivery does not exist yet.
model CampaignProductionApproval {
  id                 String    @id @default(cuid())
  campaignId         String
  finalAudienceId    String
  contentHash        String // SHA-256 over the deterministic canonical payload
  audienceHash       String // copy of the frozen audience hash, checked independently
  subjectSnapshot    String
  preheaderSnapshot  String?
  campaignLanguage   Language
  senderEmail        String
  senderName         String
  replyToEmail       String
  approvedById       String
  approvedAt         DateTime  @default(now())
  /// False while the platform has no sign-in: every action is attributed to one
  /// local development actor, so this approval cannot prove WHO approved. Four-eyes
  /// is reported BLOCKED rather than quietly passing (ADR-0003 is still pending).
  authenticatedActor Boolean   @default(false)
  /// Superseded by a newer approval, or withdrawn by a person.
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  campaign      Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  finalAudience CampaignFinalAudience @relation(fields: [finalAudienceId], references: [id], onDelete: Restrict)
  approvedBy    User                  @relation("ProductionApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([contentHash])
  @@index([revokedAt])
}

// ============================================================================
// Provider events (append-only)
// ============================================================================
model CampaignEvent {
  id                String            @id @default(cuid())
  campaignId        String
  recipientId       String?
  normalizedEmail   String?
  type              CampaignEventType
  providerEventId   String? // idempotency (nullable ok — multiple NULLs allowed)
  providerMessageId String?
  occurredAt        DateTime
  payload           Json?
  createdAt         DateTime          @default(now())

  campaign  Campaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([providerEventId])
  @@index([campaignId])
  @@index([recipientId])
  @@index([type])
}

// ============================================================================
// Unsubscribe / suppression (email-centric effective state; sync-immune)
// ============================================================================
model Unsubscribe {
  id                     String            @id @default(cuid())
  normalizedEmail        String // [H] immutable snapshot
  scope                  UnsubscribeScope  @default(GLOBAL)
  source                 UnsubscribeSource
  reason                 String?
  occurredAt             DateTime          @default(now()) // immutable original fact
  communicationAddressId String? // nav only
  campaignId             String?
  contactId              String?
  companyId              String?
  tokenId                String? // opaque token ref (no crypto yet)
  createdAt              DateTime          @default(now())

  address CommunicationAddress? @relation(fields: [communicationAddressId], references: [id], onDelete: SetNull)

  @@unique([normalizedEmail, scope]) // idempotent effective state
  @@index([normalizedEmail])
  @@index([communicationAddressId])
}

/// The last domain-authentication state READ FROM THE PROVIDER (ADR-0025).
///
/// Readiness must never claim a domain is authenticated because local configuration
/// says so. This row records what the provider actually reported, and when — so the
/// admin screen and the readiness checklist can show provider truth without making a
/// network call on every render, and can say plainly how old that truth is.
///
/// Contains no secret: DNS record values are public by definition.
model ProviderDomainSnapshot {
  id          String   @id @default(cuid())
  /// "RESEND". A string rather than an enum so a second provider needs no migration.
  provider    String
  domain      String
  /// The provider's own status verbatim (e.g. "verified", "pending", "not_started").
  status      String
  /// Derived per-mechanism state: VERIFIED / NOT_VERIFIED / UNKNOWN.
  spf         String
  dkim        String
  /// The records AXIS must publish, exactly as the provider returned them.
  records     Json
  checkedAt   DateTime @default(now())
  checkedById String?

  @@unique([provider, domain])
  @@index([checkedAt])
}

/// A capability to unsubscribe ONE address (ADR-0024).
///
/// The URL carries a 32-byte random secret; only its SHA-256 is stored here, exactly
/// as a password would be. A database leak therefore yields no working links, and a
/// tampered token simply matches nothing — there is no payload to forge because the
/// token carries no data at all. Everything the endpoint needs is on this row.
///
/// No expiry: a newsletter may be read months later, and an unsubscribe link that has
/// quietly stopped working is worse than no link.
model UnsubscribeToken {
  id                     String                  @id @default(cuid())
  /// SHA-256 (hex) of the secret in the URL. The secret itself is never stored.
  tokenHash              String                  @unique
  /// The single address this token can act on. A token for A can never affect B.
  normalizedEmail        String
  communicationAddressId String?
  /// Which newsletter carried the link, for the unsubscribe audit trail.
  campaignId             String?
  purpose                UnsubscribeTokenPurpose @default(PRODUCTION)
  createdAt              DateTime                @default(now())
  /// First successful use. Re-use is idempotent, not an error.
  firstUsedAt            DateTime?
  lastUsedAt             DateTime?
  useCount               Int                     @default(0)
  /// Set when a token must stop working (a mis-issued fixture, for example).
  revokedAt              DateTime?

  @@index([normalizedEmail])
  @@index([campaignId])
  @@index([purpose])
}

model Suppression {
  id                     String            @id @default(cuid())
  normalizedEmail        String // [H]
  reason                 SuppressionReason
  occurredAt             DateTime          @default(now())
  communicationAddressId String? // nav only
  createdAt              DateTime          @default(now())

  address CommunicationAddress? @relation(fields: [communicationAddressId], references: [id], onDelete: SetNull)

  @@unique([normalizedEmail, reason])
  @@index([normalizedEmail])
  @@index([communicationAddressId])
}

model SuppressionEvent {
  id              String            @id @default(cuid())
  normalizedEmail String
  reason          SuppressionReason
  source          String
  providerEventId String? // idempotency
  occurredAt      DateTime          @default(now())
  payload         Json?
  createdAt       DateTime          @default(now())

  @@unique([providerEventId])
  @@index([normalizedEmail])
}

// ============================================================================
// Monday sync machinery
// ============================================================================
model MondayBoard {
  id            String       @id @default(cuid())
  mondayBoardId String       @unique
  kind          CrmBoardKind
  name          String?
  columnMapping Json?
  syncCursor    String?
  lastSyncedAt  DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  syncRuns      SyncRun[]
}

model SyncRun {
  id            String        @id @default(cuid())
  mondayBoardId String
  trigger       SyncTrigger
  status        SyncStatus    @default(RUNNING)
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?
  createdCount  Int           @default(0)
  updatedCount  Int           @default(0)
  archivedCount Int           @default(0)
  skippedCount  Int           @default(0)
  errorCount    Int           @default(0)
  errorMessage  String?
  board         MondayBoard   @relation(fields: [mondayBoardId], references: [mondayBoardId], onDelete: Cascade)
  items         SyncItemLog[]

  @@index([status])
  @@index([startedAt])
}

model SyncItemLog {
  id             String         @id @default(cuid())
  syncRunId      String
  mondayItemId   String
  action         SyncItemAction
  classification SyncItemClass?
  message        String?
  rawItem        Json?
  createdAt      DateTime       @default(now())
  run            SyncRun        @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@index([syncRunId])
  @@index([mondayItemId])
}

model MondayWebhookEvent {
  id            String    @id @default(cuid())
  mondayEventId String? // idempotency
  boardId       String?
  itemId        String?
  type          String?
  payload       Json?
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  status        String?

  @@unique([mondayEventId])
  @@index([itemId])
}

// ============================================================================
// Audit trail (append-only, immutable history)
// ============================================================================
model AuditLog {
  id          String      @id @default(cuid())
  action      AuditAction
  actorUserId String?
  entityType  String?
  entityId    String?
  fromState   String?
  toState     String?
  reason      String?
  metadata    Json? // no secrets / unnecessary PII
  occurredAt  DateTime    @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([occurredAt])
}
