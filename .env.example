# =============================================================================
# AXIS Customer Communication Platform — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development and fill in real values.
# NEVER commit `.env` / `.env.local` or any real secret. This file is the
# documented template only — keep it in sync when config is added.
# Only variables actually consumed by the current milestone are required now;
# later milestones' variables are listed here (commented) so the shape is known.
# =============================================================================

# ------------------------------------------------------------------ App core
# Public base URL of the app (used for links, unsubscribe URLs, callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime environment. Note: the authoritative gate for real customer delivery is
# SEND_MODE (see below), enforced server-side — not APP_ENV. Non-production
# environments must never mail real contacts regardless of SEND_MODE.
APP_ENV="development"

# ------------------------------------------------------- Database (Milestone 1+)
# PostgreSQL connection string used by Prisma (loaded from .env.local via
# prisma.config.ts). Prisma 7 requires a real PostgreSQL DATABASE_URL before any
# migration runs. Do not use production creds locally. PostgreSQL only (no SQLite).
# Matches the local dev service in compose.yaml (`docker compose up -d`):
# DATABASE_URL="postgresql://axis:axis_dev_password@localhost:5432/axis_ccp_dev?schema=public"

# --------------------------------------------------- Authentication (Milestone 2)
AUTH_SECRET=""                   # REQUIRED. Signs/encrypts the Auth.js session
                                 # cookie. Generate with:
                                 #   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
                                 # SECRET: never commit, never log. Rotating it signs everyone out.
AUTH_URL="http://localhost:3000" # Public origin of this app. Set to the LAN/HTTPS
                                 # origin in production, e.g. https://axis.internal

# ------------------------------------------- Hosted operations (ADR-0034)
# Hosted entrypoint sets AXIS_HOSTED=true (PostgreSQL login limiter). Keep local/desktop false.
AXIS_HOSTED="false"
DB_POOL_MAX="10"                 # per app process, 1..100; add 1 health connection
DB_CONNECT_TIMEOUT_MS="5000"     # 1..30000
DB_STATEMENT_TIMEOUT_MS="30000"  # 1..120000
# AXIS_DEPLOYMENT_ID is supplied at Docker BUILD time (the release revision).
# AXIS_ALLOW_INSECURE_TEST_HTTP is reserved for the isolated container drill; never set for hosting.
# Hosted runtime configuration: ops/hosted.env.example (copy outside the repository).
# Secret-file companions, consumed by ops/start.mjs and the migrator:
# DATABASE_URL_FILE, AUTH_SECRET_FILE, CLOUDINARY_URL_FILE, MONDAY_API_TOKEN_FILE,
# GMAIL_APP_PASSWORD_FILE, RESEND_API_KEY_FILE, RESEND_WEBHOOK_SECRET_FILE.
# Explicitly mount each secret path; never set both the value and its *_FILE companion.
# Compose operator variables: AXIS_IMAGE, AXIS_MIGRATOR_IMAGE, AXIS_ENV_FILE, AXIS_HTTP_PORT.
# Backup tooling (external configuration only): BACKUP_DIR, BACKUP_DATABASE_URL_FILE,
# BACKUP_ENCRYPTION_KEY_FILE, BACKUP_RETENTION_DAYS (14 default), BACKUP_SSL_ROOT_CERT,
# RESTORE_DATABASE_URL_FILE, RESTORE_CONFIRM_DATABASE, optional PG_BIN directory.
# Container drill image overrides: OPS_APP_IMAGE, OPS_MIGRATOR_IMAGE, OPS_BACKUP_IMAGE, OPS_WORKER_IMAGE.
# All setup, retention and restore instructions: docs/operations.md.

# ------------------------------------------- Public unsubscribe (ADR-0024)
# The origin a RECIPIENT's unsubscribe link points at. Never derived from the request
# Host header: a newsletter is opened on someone else's network, days later.
# HTTPS and a publicly-reachable host are REQUIRED for production; http://localhost is
# accepted only outside production so the flow can be walked in development.
PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------ Production delivery (ADR-0024) — LOCKED
# The master switch for real customer sending. It is NOT in the database and no UI
# writes it, so no role — including ADMIN — can flip it from a browser. It stays false
# until a provider is chosen, a sending domain is authenticated (SPF/DKIM/DMARC), and
# the public unsubscribe endpoint is live on an HTTPS origin.
PRODUCTION_DELIVERY_ENABLED="false"
AXIS_DELIVERY_RELEASE_APPROVED="false"
PRODUCTION_DOMAIN_REVIEW_CONFIRMED="false"

# ------------------------------------ Automated test database (ADR-0029)
# Automated tests use a SEPARATE database and are technically incapable of using the
# operational one. The name must be `axis_ccp_test` or end in `_test`; `axis_ccp_dev`
# is refused by name. A missing value FAILS THE TEST RUN — it never falls back to
# DATABASE_URL. Never point this at an operational database.
TEST_DATABASE_URL="postgresql://axis:CHANGE_ME@localhost:5432/axis_ccp_test?schema=public"

# ------------------------------------------- Resend provider (ADR-0025)
# The production email vendor. Selecting it here does NOT enable customer sending —
# PRODUCTION_DELIVERY_ENABLED above is a separate switch, and both are required.
PRODUCTION_EMAIL_PROVIDER="resend"
# SECRET. Put the real key in .env.local (git-ignored) — NEVER in this file, never in
# a commit, never in a log line. Create it at https://resend.com/api-keys with SENDING
# access only, restricted to the axis-gps.com domain.
RESEND_API_KEY=""
# SECRET. Shown once when the webhook endpoint is created in the Resend dashboard.
# Without it, delivery/bounce/complaint events cannot be verified and are refused.
RESEND_WEBHOOK_SECRET=""

# ---------------------------------- Internal provider pilot (ADR-0025) — OFF
# Allows ONE internal test email through Resend, as newsletter@axis-gps.com, to the
# single hard-coded address khaled-s@axis-gps.com. It is not customer sending and it
# never becomes customer sending: that needs PRODUCTION_DELIVERY_ENABLED, which this
# variable does not touch. Like it, there is no UI that writes this.
PROVIDER_PILOT_ENABLED="false"

# ------------------------------------ Internal QA email (ADR-0027) — OFF
# Allows internal QA test emails through the Gmail transport to the FOUR approved
# AXIS addresses and to nobody else. A SEPARATE mechanism from the SAFE TEST
# hard-lock, which is unchanged and still reaches exactly one address.
# It is not customer sending and cannot become customer sending: that needs
# PRODUCTION_DELIVERY_ENABLED, which this variable does not touch. No UI writes it.
QA_EMAIL_ENABLED="false"

# NOTE: there is deliberately NO seed-admin email/password variable (ADR-0023).
# The first administrator is created once, in the browser, at /setup — so no
# plaintext staff password ever exists in a file, an environment, or a shell history.
# That page closes itself permanently as soon as one active administrator exists.

# ------------------------------------------- Monday.com CRM (Milestone 4 sync)
# Monday.com is the SOURCE OF TRUTH for CRM master data (ADR-0007). This platform
# is a read-only projection in v1 — it never writes back to Monday.
# MONDAY_API_URL="https://api.monday.com/v2"
# MONDAY_API_TOKEN=""            # Monday API token (least privilege, read scope)
# MONDAY_WEBHOOK_SIGNING_SECRET="" # to verify inbound Monday webhooks
# MONDAY_ACCOUNTS_BOARD_ID=""    # board id holding companies/accounts
# MONDAY_CONTACTS_BOARD_ID=""    # board id holding contacts/people
# MONDAY_SYNC_INTERVAL_MINUTES="15" # reconciliation backstop interval

# ------------------------------------- Newsletter image storage (ADR-0016)
# LOCAL (default) stores uploads in git-ignored var/media/ — usable for development,
# but such images are OMITTED from real email because a recipient cannot load them.
# Set MEDIA_PROVIDER=cloudinary to upload to Cloudinary and get public HTTPS URLs.
#
# CLOUDINARY_URL is a SECRET: it embeds the API key and secret
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Copy it from the Cloudinary console (Dashboard -> API Environment variable).
# It is read server-side only and is never sent to the browser. Never commit a real value.
MEDIA_PROVIDER="local"          # "local" | "cloudinary"
CLOUDINARY_URL=""               # required when MEDIA_PROVIDER=cloudinary

# Public HTTPS logo for the newsletter header. Must be HTTPS and publicly reachable —
# localhost, private/link-local IPs and internal hostnames are rejected, because a
# recipient could never load them. When unset or invalid the email falls back to the
# AXIS text wordmark, which always renders (including with images blocked).
# Cloudinary URLs are automatically delivered at the logo's retina width.
# AXIS_EMAIL_LOGO_URL=""

# ------------------------------------ Gmail SMTP SAFE TEST send (ADR-0014)
# The ONLY test direction: axisgpscana@gmail.com -> khaled-s@axis-gps.com.
# Both addresses are ALSO hard-coded constants in the domain; these variables are a
# cross-check, never the source of truth. An env var must not be able to redirect a
# test email, so a mismatch makes sending unavailable rather than changing the target.
#
# GMAIL_APP_PASSWORD is a Google **App Password** (16 characters), NOT the account
# password. See docs/gmail-smtp-setup.md. Never commit a real value.
EMAIL_PROVIDER="gmail_smtp"
GMAIL_SMTP_USER="axisgpscana@gmail.com"     # must equal SAFE_TEST_SENDER
GMAIL_APP_PASSWORD=""                       # 16-char Google App Password
SAFE_TEST_SENDER="axisgpscana@gmail.com"    # the ONLY authorized sender
SAFE_TEST_RECIPIENT="khaled-s@axis-gps.com" # the ONLY authorized test recipient

# Production uses the separate PRODUCTION_EMAIL_PROVIDER / RESEND_* configuration
# documented above. EMAIL_PROVIDER remains the Gmail SAFE TEST transport selector.
# Customer scheduling and the external release procedure: docs/workflow-operations.md.

# ------------------------------------------ Send mode / safe-send (ADR-0008)
# TEST is the default. In TEST mode NO email reaches real customers — every
# delivery is redirected to SAFE_SEND_REDIRECT_TO. Switching to PRODUCTION is an
# explicit administrative action and must never happen automatically.
SEND_MODE="TEST"                 # "TEST" | "PRODUCTION" (TEST is the enforced default)

# ---------------------------------------------------------------------------
# Newsletter sender identity (ADR-0019)
# ---------------------------------------------------------------------------
# Where a recipient's reply goes. The authenticated Gmail mailbox still SENDS the
# message; only the reply destination moves. Central configuration — there is no
# per-newsletter field and no UI input for it.
# Must be exactly ONE plain address: no list, no "Name <addr>" form, no control
# characters. A malformed value makes test sending unavailable rather than falling
# back silently. Changing it invalidates any existing test-send approval.
NEWSLETTER_REPLY_TO="noreply@axis-gps.com"
# The friendly From name is a constant in code: "AXIS Advanced Mapping Solutions".
# Unsubscribe stays footer-only: no List-Unsubscribe header is generated.
SAFE_SEND_FROM="axisgpscana@gmail.com"         # sole sender in TEST mode
SAFE_SEND_REDIRECT_TO="khaled-s@axis-gps.com"  # sole delivery target in TEST mode
# Optional extra allowed test recipients (still never real customers in TEST mode).
# EMAIL_TEST_RECIPIENTS=""

# ------------------------------------ Durable scheduled work (ADR-0035)
SCHEDULER_ENABLED="false"
SCHEDULER_TRIGGER_SECRET="" # Dedicated random secret, at least 32 characters; *_FILE supported.
# Worker-only URL. Never contains a secret. Remote workers require HTTPS.
# SCHEDULER_URL="http://127.0.0.1:3000/api/internal/jobs/tick"
MONDAY_WEBHOOK_ENABLED="false"
MONDAY_SIGNING_SECRET="" # Monday integration app Signing Secret; *_FILE supported.
MONDAY_ACCOUNT_ID="" # Decimal account id required for signed event validation.
# Setup, consent gates, explicit release and recovery: docs/workflow-operations.md.

# -------------------------------- Reviewed Hebrew article translation (ADR-0037)
TRANSLATION_ENABLED="false"
OPENAI_API_KEY="" # Server only. Provision outside source control; never paste into an article.
TRANSLATION_OPENAI_MODEL="gpt-5.4-mini-2026-03-17"
# OpenAI API usage is billed to its configured project. Set a project spending limit.
# Explicit article requests only; no automatic translation, approval or sending.
# Setup and limits: docs/hebrew-translation.md.
