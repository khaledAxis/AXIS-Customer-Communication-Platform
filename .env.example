# =============================================================================
# AXIS Customer Communication Platform — Environment Variables (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to `.env.local` for development and fill in real values.
# NEVER commit `.env` / `.env.local` or any real secret. This file is the
# documented template only — keep it in sync when config is added.
# Only variables actually consumed by the current milestone are required now;
# later milestones' variables are listed here (commented) so the shape is known.
# =============================================================================

# ------------------------------------------------------------------ App core
# Public base URL of the app (used for links, unsubscribe URLs, callbacks).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime environment. Note: the authoritative gate for real customer delivery is
# SEND_MODE (see below), enforced server-side — not APP_ENV. Non-production
# environments must never mail real contacts regardless of SEND_MODE.
APP_ENV="development"

# ------------------------------------------------------- Database (Milestone 1+)
# PostgreSQL connection string used by Prisma (loaded from .env.local via
# prisma.config.ts). Prisma 7 requires a real PostgreSQL DATABASE_URL before any
# migration runs. Do not use production creds locally. PostgreSQL only (no SQLite).
# Matches the local dev service in compose.yaml (`docker compose up -d`):
# DATABASE_URL="postgresql://axis:axis_dev_password@localhost:5432/axis_ccp_dev?schema=public"

# --------------------------------------------------- Authentication (Milestone 2)
# Auth.js (NextAuth v5) secret — generate with: openssl rand -base64 32
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"
# Initial admin seeded on first run (change immediately; never commit real values).
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# ------------------------------------------- Monday.com CRM (Milestone 4 sync)
# Monday.com is the SOURCE OF TRUTH for CRM master data (ADR-0007). This platform
# is a read-only projection in v1 — it never writes back to Monday.
# MONDAY_API_URL="https://api.monday.com/v2"
# MONDAY_API_TOKEN=""            # Monday API token (least privilege, read scope)
# MONDAY_WEBHOOK_SIGNING_SECRET="" # to verify inbound Monday webhooks
# MONDAY_ACCOUNTS_BOARD_ID=""    # board id holding companies/accounts
# MONDAY_CONTACTS_BOARD_ID=""    # board id holding contacts/people
# MONDAY_SYNC_INTERVAL_MINUTES="15" # reconciliation backstop interval

# ------------------------------------- Newsletter image storage (ADR-0016)
# LOCAL (default) stores uploads in git-ignored var/media/ — usable for development,
# but such images are OMITTED from real email because a recipient cannot load them.
# Set MEDIA_PROVIDER=cloudinary to upload to Cloudinary and get public HTTPS URLs.
#
# CLOUDINARY_URL is a SECRET: it embeds the API key and secret
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Copy it from the Cloudinary console (Dashboard -> API Environment variable).
# It is read server-side only and is never sent to the browser. Never commit a real value.
MEDIA_PROVIDER="local"          # "local" | "cloudinary"
CLOUDINARY_URL=""               # required when MEDIA_PROVIDER=cloudinary

# Public HTTPS logo for the newsletter header. Must be HTTPS and publicly reachable —
# localhost, private/link-local IPs and internal hostnames are rejected, because a
# recipient could never load them. When unset or invalid the email falls back to the
# AXIS text wordmark, which always renders (including with images blocked).
# Cloudinary URLs are automatically delivered at the logo's retina width.
# AXIS_EMAIL_LOGO_URL=""

# ------------------------------------ Gmail SMTP SAFE TEST send (ADR-0014)
# The ONLY test direction: axisgpscana@gmail.com -> khaled-s@axis-gps.com.
# Both addresses are ALSO hard-coded constants in the domain; these variables are a
# cross-check, never the source of truth. An env var must not be able to redirect a
# test email, so a mismatch makes sending unavailable rather than changing the target.
#
# GMAIL_APP_PASSWORD is a Google **App Password** (16 characters), NOT the account
# password. See docs/gmail-smtp-setup.md. Never commit a real value.
EMAIL_PROVIDER="gmail_smtp"
GMAIL_SMTP_USER="axisgpscana@gmail.com"     # must equal SAFE_TEST_SENDER
GMAIL_APP_PASSWORD=""                       # 16-char Google App Password
SAFE_TEST_SENDER="axisgpscana@gmail.com"    # the ONLY authorized sender
SAFE_TEST_RECIPIENT="khaled-s@axis-gps.com" # the ONLY authorized test recipient

# ------------------------------------- Bulk email provider (later, Milestone 10)
# For production newsletters to many recipients (Resend/Postmark/SES — ADR-0004).
# EMAIL_PROVIDER=""              # e.g. "resend" | "postmark" | "ses"
# EMAIL_API_KEY=""               # provider API key (least privilege)
# EMAIL_FROM=""                  # verified sender, e.g. "AXIS <news@axis.example>"
# EMAIL_WEBHOOK_SECRET=""        # to verify inbound provider webhooks

# ------------------------------------------ Send mode / safe-send (ADR-0008)
# TEST is the default. In TEST mode NO email reaches real customers — every
# delivery is redirected to SAFE_SEND_REDIRECT_TO. Switching to PRODUCTION is an
# explicit administrative action and must never happen automatically.
SEND_MODE="TEST"                 # "TEST" | "PRODUCTION" (TEST is the enforced default)

# ---------------------------------------------------------------------------
# Newsletter sender identity (ADR-0019)
# ---------------------------------------------------------------------------
# Where a recipient's reply goes. The authenticated Gmail mailbox still SENDS the
# message; only the reply destination moves. Central configuration — there is no
# per-newsletter field and no UI input for it.
# Must be exactly ONE plain address: no list, no "Name <addr>" form, no control
# characters. A malformed value makes test sending unavailable rather than falling
# back silently. Changing it invalidates any existing test-send approval.
NEWSLETTER_REPLY_TO="noreply@axis-gps.com"
# The friendly From name is a constant in code: "AXIS Advanced Mapping Solutions".
# Unsubscribe stays footer-only: no List-Unsubscribe header is generated.
SAFE_SEND_FROM="axisgpscana@gmail.com"         # sole sender in TEST mode
SAFE_SEND_REDIRECT_TO="khaled-s@axis-gps.com"  # sole delivery target in TEST mode
# Optional extra allowed test recipients (still never real customers in TEST mode).
# EMAIL_TEST_RECIPIENTS=""

# --------------------------------------------------- Scheduler (Milestone 11)
# Shared secret required to invoke the due-campaign trigger endpoint.
# SCHEDULER_TRIGGER_SECRET=""

# ------------------------------------------------- AI assistance (Milestone 13)
# Claude API key for content summarization (later phase, human-reviewed output).
# ANTHROPIC_API_KEY=""
