{
  "name": "axis-customer-communication-platform",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:dev": "concurrently \"cross-env AUTH_URL=http://127.0.0.1:3000 NEXTAUTH_URL=http://127.0.0.1:3000 AUTH_TRUST_HOST=true npm run dev -- --hostname 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_SKIP_NEXT_SERVER=1 electron .\"",
    "desktop:prepare": "node electron/prepare-standalone.js",
    "desktop:build": "next build && npm run desktop:prepare && electron-builder --win portable",
    "desktop:configure": "node electron/install-config.js",
    "desktop:test": "node --test electron/*.test.js",
    "desktop:smoke": "node electron/run-packaged-smoke.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:workflows": "tsc -p tsconfig.workflows.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test:db:reset": "node scripts/reset-test-db.mjs",
    "test:db:migrate": "node scripts/migrate-test-db.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "ops:manifest": "node ops/migration-manifest.mjs",
    "ops:manifest:check": "node ops/migration-manifest.mjs --check",
    "ops:test": "node --test ops/*.test.mjs",
    "ops:backup": "node ops/database-backup.mjs",
    "ops:smoke": "node ops/container-smoke.mjs",
    "ops:worker": "node ops/worker.mjs",
    "ops:benchmark": "cross-env OPS_BENCHMARK=true node ops/container-smoke.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "jose": "6.2.9",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.axis.customercommunicationplatform",
    "productName": "AXIS Customer Communication Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "electron/navigation-policy.js",
      "electron/runtime-config.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next",
        "filter": [
          "server.js",
          "package.json",
          ".next/**/*",
          "public/**/*",
          "var/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "axis-ccp-${version}.exe"
    }
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
